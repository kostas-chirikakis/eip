<!--
  Cube RM — global inbound policy.

  The gateway is a coarse, fast gate. It is NOT the authorization decision. Its one
  invariant: it can only ever reject more, never permit more. Nothing it sets is trusted by
  the backend as a grant.

  XML note: attributes whose expression contains double quotes use single-quote delimiters.
  Generics are written &lt; because '<' is not legal in an XML attribute value.

  See docs/identity/04-apim-configuration.md
-->
<policies>
  <inbound>
    <!--
      FIRST, unconditionally: strip client-supplied X-Cube-* headers. A client that can
      inject X-Cube-Org-Id crosses tenants the moment any code anywhere trusts it. These
      are set below from validated claims only.
    -->
    <set-header name="X-Cube-Org-Id" exists-action="delete" />
    <set-header name="X-Cube-Org-Slug" exists-action="delete" />
    <set-header name="X-Cube-Gateway-Validated" exists-action="delete" />

    <include-fragment fragment-id="cube-multi-issuer-validate" />
    <include-fragment fragment-id="cube-org-deny-list" />

    <!-- Per-organisation rate limiting. Noisy-neighbour protection is a real isolation
         property in a shared platform, and it appears in enterprise contracts as an
         availability commitment. -->
    <rate-limit-by-key calls="600" renewal-period="60"
                       counter-key='@((string)context.Variables["orgId"])'
                       increment-condition="@(context.Response.StatusCode != 429)" />
    <quota-by-key calls="500000" renewal-period="86400"
                  counter-key='@((string)context.Variables["orgId"])' />

    <!-- Correlation only. The backend derives organisation from the token it validates
         itself, compares it against this header, and alerts on mismatch (§3.4). -->
    <set-header name="X-Cube-Org-Id" exists-action="override">
      <value>@((string)context.Variables["orgId"])</value>
    </set-header>
    <set-header name="X-Cube-Correlation-Id" exists-action="skip">
      <value>@(context.RequestId.ToString())</value>
    </set-header>
    <set-header name="X-Cube-Gateway-Validated" exists-action="override">
      <value>true</value>
    </set-header>

    <!-- Backend authentication, so the backend can assert the call came from the gateway
         independent of network position. -->
    <authentication-managed-identity resource="{{backend-resource-id}}" />

    <base />
  </inbound>

  <backend><base /></backend>

  <outbound>
    <!-- Never leak backend implementation detail. -->
    <set-header name="X-Powered-By" exists-action="delete" />
    <set-header name="Server" exists-action="delete" />
    <base />
  </outbound>

  <on-error>
    <!-- Generic error body. Detailed auth failures at the edge are a reconnaissance aid. -->
    <set-header name="Content-Type" exists-action="override">
      <value>application/json</value>
    </set-header>
    <set-body><![CDATA[@{
      return new JObject(
        new JProperty("error", context.LastError?.Reason ?? "request_failed"),
        new JProperty("correlationId", context.RequestId.ToString())
      ).ToString();
    }]]></set-body>
    <base />
  </on-error>
</policies>
