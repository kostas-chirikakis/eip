<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Microsoft.NET.Sdk with a framework reference, NOT Microsoft.NET.Sdk.Web.

    This project is currently a library of endpoint definitions with no Program.cs and no
    host. The Web SDK would demand an entry point. Switch it to Sdk.Web at the point a host
    is actually written, not before — an empty Program.cs added only to satisfy the SDK
    would misrepresent this as a runnable service.
  -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CubeRM.Identity.Application/CubeRM.Identity.Application.csproj" />
    <ProjectReference Include="../CubeRM.SharedKernel.Auth/CubeRM.SharedKernel.Auth.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" />
    <!-- WithOpenApi() is not in the shared framework; it ships in this package. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

</Project>
